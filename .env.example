# --- Local (stdio) mode -------------------------------------------------------
# API token of a Hetzner Cloud project (Hetzner Console -> Security -> API Tokens).
HETZNER_API_TOKEN=your_token_here

# Several projects: one variable per project, the suffix becomes the project name.
# HETZNER_API_TOKEN_PROD=...
# HETZNER_API_TOKEN_STAGING=...
# HETZNER_DEFAULT_PROJECT=prod

# Dedicated servers: Robot webservice user (Robot -> Settings -> Web service and app settings).
# HETZNER_ROBOT_USER=#ws+xxxxxxxx
# HETZNER_ROBOT_PASSWORD=...

# Remove hetzner_execute, only GET requests are possible.
# HETZNER_READ_ONLY=1

# Allow requests that cost money (new servers, volumes, IPs, ...). Default: refused.
# HETZNER_ALLOW_BILLED=1

# --- Hosted (--http) mode -----------------------------------------------------
# HETZNER_MCP_PUBLIC_URL=https://hetzner-mcp.example.com
# HETZNER_MCP_SECRET=            # at least 32 characters: openssl rand -base64 48
# HETZNER_MCP_TENANTS_FILE=./tenants.json
# HETZNER_MCP_DB_PATH=./data/hetzner-mcp.sqlite
