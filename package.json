{
  "name": "hetzner-code-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Hetzner Cloud and Robot APIs in code mode: search the API reference, then run JavaScript against the API. Local (stdio) or hosted (Streamable HTTP + OAuth).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hetzner-code-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec/operations.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "update-spec": "node scripts/update-spec.mjs",
    "test": "npm run build && node --test --test-timeout=30000 --test-force-exit \"test/*.test.mjs\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "cursor",
    "hetzner",
    "hetzner-cloud",
    "hcloud",
    "hetzner-robot",
    "dedicated-server",
    "dns",
    "code-mode",
    "infrastructure"
  ],
  "author": "stack74",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stack74/hetzner-mcp.git"
  },
  "homepage": "https://github.com/stack74/hetzner-mcp#readme",
  "bugs": {
    "url": "https://github.com/stack74/hetzner-mcp/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
